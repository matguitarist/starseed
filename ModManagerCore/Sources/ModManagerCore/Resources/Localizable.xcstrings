    "Add your Nexus Mods API key in Settings to download mods." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge in den Einstellungen deinen Nexus-Mods-API-Schlüssel hinzu, um Mods herunterzuladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu clave de API de Nexus Mods en Ajustes para descargar mods."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez votre clé d’API Nexus Mods dans les Réglages pour télécharger des mods."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione sua chave de API do Nexus Mods nos Ajustes para baixar mods."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在设置中添加 Nexus Mods API 密钥以下载模组。"
          }
        }
      }
    },
