    "Nexus didn't return a download link for this file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nexus hat keinen Downloadlink für diese Datei geliefert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nexus no devolvió un enlace de descarga para este archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
