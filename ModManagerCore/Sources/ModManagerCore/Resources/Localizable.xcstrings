    "SMAPI's installer needs Rosetta. Install it by running “softwareupdate --install-rosetta” in Terminal, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der SMAPI-Installer braucht Rosetta. Installiere es mit „softwareupdate --install-rosetta“ im Terminal und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El instalador de SMAPI necesita Rosetta. Instálalo con «softwareupdate --install-rosetta» en Terminal y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’installateur de SMAPI a besoin de Rosetta. Installez-le en lançant « softwareupdate --install-rosetta » dans le Terminal, puis réessayez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O instalador do SMAPI precisa do Rosetta. Instale-o com “softwareupdate --install-rosetta” no Terminal e tente de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
