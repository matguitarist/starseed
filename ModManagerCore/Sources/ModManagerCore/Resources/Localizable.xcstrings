    "Nexus only allows direct downloads for Premium members. Use “Mod Manager Download” on the website instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nexus erlaubt direkte Downloads nur für Premium-Mitglieder. Nutze stattdessen „Mod Manager Download“ auf der Website."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nexus solo permite descargas directas a los miembros Premium. Usa «Mod Manager Download» en la web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nexus ne permet les téléchargements directs qu’aux membres Premium. Utilisez plutôt « Mod Manager Download » sur le site."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Nexus só permite downloads diretos para membros Premium. Use “Mod Manager Download” no site."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nexus 只允许高级会员直接下载。请改用网站上的“Mod Manager Download”。"
          }
        }
      }
    },
    "Nexus rate limit reached. Try again in a little while." : {
