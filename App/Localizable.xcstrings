    "Most problems show up in the **SMAPI Log**. The Stardew Valley modding community can help with it on the official forums and Discord." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die meisten Probleme zeigen sich im **SMAPI-Protokoll**. Die Stardew-Valley-Modding-Community hilft dabei in den offiziellen Foren und auf Discord."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayoría de los problemas aparecen en el **Registro de SMAPI**. La comunidad de modding de Stardew Valley puede ayudarte en los foros oficiales y en Discord."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plupart des problèmes apparaissent dans le **Journal SMAPI**. La communauté de modding de Stardew Valley peut vous aider sur les forums officiels et Discord."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A maioria dos problemas aparece no **Registro do SMAPI**. A comunidade de modding de Stardew Valley pode ajudar nos fóruns oficiais e no Discord."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大多数问题都会出现在 **SMAPI 日志**中。星露谷物语模组社区可以在官方论坛和 Discord 上提供帮助。"
          }
        }
      }
    },
