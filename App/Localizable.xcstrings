        }
      }
    },
    "SMAPI writes a log each time the game runs. The **SMAPI Log** section shows the latest one with colors per level (errors, warnings, info…) and filters by level, mod or text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI schreibt bei jedem Spielstart ein Protokoll. Der Bereich **SMAPI-Protokoll** zeigt das neueste mit Farben je Stufe (Fehler, Warnungen, Infos …) und filtert nach Stufe, Mod oder Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI escribe un registro cada vez que se ejecuta el juego. La sección **Registro de SMAPI** muestra el más reciente con colores por nivel (errores, avisos, información…) y filtros por nivel, mod o texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI écrit un journal à chaque lancement du jeu. La section **Journal SMAPI** affiche le plus récent avec une couleur par niveau (erreurs, avertissements, infos…) et des filtres par niveau, mod ou texte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SMAPI grava um registro cada vez que o jogo roda. A seção **Registro do SMAPI** mostra o mais recente com cores por nível (erros, avisos, informações…) e filtros por nível, mod ou texto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次运行游戏时 SMAPI 都会写入日志。**SMAPI 日志**部分会以不同颜色显示最新日志的各个级别（错误、警告、信息…），并可按级别、模组或文本过滤。"
          }
        }
      }
    },
