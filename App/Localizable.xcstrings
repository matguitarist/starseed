    "Mods can't be rolled back to these versions afterwards, unless you put them back from the Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mods können danach nicht mehr auf diese Versionen zurück, außer du holst sie aus dem Papierkorb."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después los mods no podrán volver a estas versiones, salvo que las recuperes de la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mods ne pourront plus revenir à ces versions, sauf si vous les récupérez dans la Corbeille."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois, os mods não poderão voltar para essas versões, a menos que você as recupere da Lixeira."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之后模组将无法回退到这些版本，除非你从废纸篓中找回它们。"
          }
        }
      }
    },
    "Mods can't be swapped while the game is running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mods können nicht gewechselt werden, während das Spiel läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden cambiar los mods mientras el juego está abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de changer de mods pendant que le jeu tourne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível trocar os mods com o jogo aberto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏运行时无法切换模组。"
          }
        }
      }
    },
