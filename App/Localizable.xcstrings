    "Clear: hide everything logged so far and show only new messages (⌘K). The log file isn't changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leeren: alles bisher Protokollierte ausblenden und nur neue Meldungen zeigen (⌘K). Die Protokolldatei wird nicht verändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borrar: oculta todo lo registrado hasta ahora y muestra solo los mensajes nuevos (⌘K). El archivo de registro no cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effacer : masquer tout ce qui a été journalisé jusqu’ici et n’afficher que les nouveaux messages (⌘K). Le fichier journal n’est pas modifié."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpar: oculta tudo o que foi registrado até agora e mostra só as novas mensagens (⌘K). O arquivo de registro não é alterado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除：隐藏目前为止记录的所有内容，只显示新消息（⌘K）。日志文件不会被修改。"
          }
        }
      }
    },
