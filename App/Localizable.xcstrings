        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI %@"
          }
        }
      }
    },
    "SMAPI %@ installed — %@ is available" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SMAPI %1$@ installed — %2$@ is available"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI %1$@ installé — la version %2$@ est disponible"
          }
