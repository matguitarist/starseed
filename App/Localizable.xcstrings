    "%@ contains mods already in your Mods folder:\n\n%@\n\nReplace them with this version? Old versions go to the Trash and their config.json settings are kept." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ contains mods already in your Mods folder:\n\n%2$@\n\nReplace them with this version? Old versions go to the Trash and their config.json settings are kept."
