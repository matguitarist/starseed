    "%@ contains mods already in your Mods folder:\n\n%@\n\nReplace them with this version? Old versions go to the Trash and their config.json settings are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ enthält Mods, die schon in deinem Mods-Ordner sind:\n\n%2$@\n\nDurch diese Version ersetzen? Alte Versionen kommen in den Papierkorb, ihre config.json-Einstellungen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ contains mods already in your Mods folder:\n\n%2$@\n\nReplace them with this version? Old versions go to the Trash and their config.json settings are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ contiene mods que ya están en tu carpeta Mods:\n\n%2$@\n\n¿Reemplazarlos por esta versión? Las versiones antiguas van a la Papelera y se conservan sus ajustes de config.json."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ contient des mods déjà présents dans votre dossier Mods :\n\n%2$@\n\nLes remplacer par cette version ? Les anciennes versions vont à la Corbeille et leurs réglages config.json sont conservés."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ contém mods que já estão na sua pasta Mods:\n\n%2$@\n\nSubstituir por esta versão? As versões antigas vão para a Lixeira e os ajustes do config.json são mantidos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 包含你的 Mods 文件夹中已有的模组：\n\n%2$@\n\n要用此版本替换吗？旧版本会移到废纸篓，其 config.json 设置会保留。"
          }
        }
      }
    },
