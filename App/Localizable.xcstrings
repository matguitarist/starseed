    "“%@” no longer exists. Pick another one for this save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ gibt es nicht mehr. Wähle für diesen Spielstand etwas anderes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ya no existe. Elige otro para esta partida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’existe plus. Choisissez-en un autre pour cette sauvegarde."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não existe mais. Escolha outro para este save."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已不存在。请为此存档选择其他项。"
          }
        }
      }
    },
    "(During: %@.)" : {
      "localizations" : {
