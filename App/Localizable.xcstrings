    "If it's installed but disabled, **Enable** turns it back on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist er installiert, aber deaktiviert, schaltet **Aktivieren** ihn wieder ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está instalado pero desactivado, **Activar** lo vuelve a encender."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’il est installé mais désactivé, **Activer** le réactive."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se estiver instalado mas desativado, **Ativar** o liga de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果已安装但被停用，**启用**会重新打开它。"
          }
        }
      }
    },
    "If the same mod is installed twice, SMAPI loads neither copy: a banner offers **Keep Newest**." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist derselbe Mod doppelt installiert, lädt SMAPI keine der Kopien: Ein Banner bietet **Neueste behalten** an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el mismo mod está instalado dos veces, SMAPI no carga ninguna copia: un banner ofrece **Conservar el más reciente**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un mod est installé deux fois, SMAPI ne charge aucune des copies : un bandeau propose **Garder le plus récent**."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o mesmo mod estiver instalado duas vezes, o SMAPI não carrega nenhuma cópia: uma faixa oferece **Manter o mais recente**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果同一模组安装了两次，SMAPI 两个都不会加载：横幅会提供**保留最新的**。"
          }
        }
      }
    },
