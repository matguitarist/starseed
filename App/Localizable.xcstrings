    "Links in this app open in its own Nexus browser, which catches these downloads itself. Making this app the default also catches “Mod Manager Download” clicks in Safari or Chrome." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les liens de cette app s’ouvrent dans son propre navigateur Nexus, qui intercepte lui-même ces téléchargements. Faire de cette app l’app par défaut intercepte aussi les clics « Mod Manager Download » dans Safari ou Chrome."
          }
        }
      }
    },
    "Load More" : {
