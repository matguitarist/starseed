      }
    },
    "**Updates**: checking mods every few hours, notifications, and the menu bar icon." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Updates**: Mods alle paar Stunden prüfen, Mitteilungen und das Menüleistensymbol."
