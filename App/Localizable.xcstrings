        }
      }
    },
    "Use “%@”?" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser « %@ » ?"
          }
        }
      }
    },
    "Use **Mods → Find a Broken Mod…**. Starseed turns off half of your mods, you play and say whether the problem happened, and after a few tests it names the mod. Your mods are put back at the end." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez **Mods → Trouver un mod défectueux…**. Starseed désactive la moitié de vos mods, vous jouez et dites si le problème est apparu, et après quelques tests il nomme le mod. Vos mods sont remis en place à la fin."
          }
        }
      }
    },
    "Use Mods & Play" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
