            "value" : "(Durante: %@.)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（发生于：%@。）"
          }
        }
      }
    },
    "(found via “%@”)" : {
      "localizations" : {
