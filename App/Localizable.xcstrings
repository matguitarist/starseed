    "The game starts without mods." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel startet ohne Mods."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego se inicia sin mods."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu démarre sans mods."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O jogo abre sem mods."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏启动时没有模组。"
          }
        }
      }
    },
    "The game wasn't started, to keep your saves safe: %@\n\nTo play anyway, turn off “Back up saves before playing” in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel wurde nicht gestartet, um deine Spielstände zu schützen: %@\n\nUm trotzdem zu spielen, schalte „Spielstände vor dem Spielen sichern“ in den Einstellungen aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se inició el juego para proteger tus partidas: %@\n\nPara jugar de todos modos, desactiva «Copiar las partidas antes de jugar» en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu n’a pas été lancé, pour protéger vos sauvegardes : %@\n\nPour jouer quand même, désactivez « Copier les sauvegardes avant de jouer » dans les Réglages."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O jogo não foi aberto, para proteger seus saves: %@\n\nPara jogar mesmo assim, desative “Fazer backup dos saves antes de jogar” nos Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为保护你的存档，游戏未启动：%@\n\n如果仍要游戏，请在设置中关闭“模组有变化时，在开始游戏前备份存档”。"
          }
        }
      }
    },
    "The game will start without mods" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel startet ohne Mods"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego se iniciará sin mods"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu démarrera sans mods"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O jogo vai abrir sem mods"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏将在没有模组的情况下启动"
          }
        }
      }
    },
    "The game would overwrite the restored save the next time it saves. Quit to the desktop, then restore." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel würde den wiederhergestellten Spielstand beim nächsten Speichern überschreiben. Beende es zum Schreibtisch und stelle dann wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego sobrescribiría la partida restaurada la próxima vez que guarde. Sal al escritorio y luego restaura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu écraserait la sauvegarde restaurée lors de son prochain enregistrement. Quittez le jeu, puis restaurez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O jogo sobrescreveria o save restaurado na próxima vez que salvar. Saia para a área de trabalho e depois restaure."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏下次存档时会覆盖恢复的存档。请退出到桌面后再恢复。"
          }
        }
      }
    },
    "The Installed list" : {
