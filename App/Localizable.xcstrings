    },
    "This link is for “%@”. Only Stardew Valley mods can be installed here." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien concerne « %@ ». Seuls les mods Stardew Valley peuvent être installés ici."
          }
        }
