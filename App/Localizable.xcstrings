    },
    "SMAPI %@ is available" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI %@ est disponible"
          }
        }
      }
    },
    "SMAPI %@ is available." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI %@ est disponible."
          }
        }
      }
    },
    "SMAPI %@ is installed. Launch the game as usual to play with mods." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI %@ est installé. Lancez le jeu comme d’habitude pour jouer avec vos mods."
          }
        }
      }
    },
    "SMAPI can only use one, so it used the game's original files and neither change shows. Disable one of the mods to fix it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI ne peut en utiliser qu’un : il a donc gardé les fichiers d’origine du jeu et aucune des deux modifications n’apparaît. Désactivez l’un des mods pour corriger."
          }
        }
      }
    },
    "SMAPI can't be installed while the game is running." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI ne peut pas être installé pendant que le jeu tourne."
          }
        }
      }
    },
    "SMAPI database" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "base SMAPI"
          }
        }
      }
    },
    "SMAPI goes next to the game, but your Mods folder isn't inside it. Opening SMAPI's download page instead." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI s’installe à côté du jeu, mais votre dossier Mods n’est pas dedans. Ouverture de la page de téléchargement de SMAPI à la place."
          }
        }
      }
    },
    "SMAPI Installer Ready" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installateur SMAPI prêt"
          }
        }
      }
    },
    "SMAPI is probably missing or was removed by a game update. Run SMAPI's installer again (**Get SMAPI…**)." : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI manque probablement, ou une mise à jour du jeu l’a retiré. Relancez l’installateur de SMAPI (**Obtenir SMAPI…**)."
          }
        }
      }
    },
    "SMAPI isn't installed" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI n’est pas installé"
          }
        }
      }
    },
    "SMAPI Log" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Journal SMAPI"
          }
        }
