    "SMAPI %@ is installed. Launch the game as usual to play with mods." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI %@ ist installiert. Starte das Spiel wie gewohnt, um mit Mods zu spielen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI %@ está instalado. Inicia el juego como siempre para jugar con mods."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI %@ est installé. Lancez le jeu comme d’habitude pour jouer avec vos mods."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI %@ instalado. Abra o jogo como de costume para jogar com mods."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI %@ 已安装。像往常一样启动游戏即可使用模组。"
          }
        }
      }
    },
    "SMAPI can only use one, so it used the game's original files and neither change shows. Disable one of the mods to fix it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI kann nur einen verwenden, also hat es die Originaldateien des Spiels genommen, und keine der Änderungen ist zu sehen. Deaktiviere einen der Mods, um das zu beheben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI solo puede usar uno, así que usó los archivos originales del juego y no se ve ningún cambio. Desactiva uno de los mods para solucionarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI ne peut en utiliser qu’un : il a donc gardé les fichiers d’origine du jeu et aucune des deux modifications n’apparaît. Désactivez l’un des mods pour corriger."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SMAPI só pode usar um, então usou os arquivos originais do jogo e nenhuma das mudanças aparece. Desative um dos mods para corrigir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI 只能使用其中一个，因此使用了游戏的原始文件，两者的修改都不会显示。停用其中一个模组即可解决。"
          }
        }
      }
    },
    "SMAPI can't be installed while the game is running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI kann nicht installiert werden, während das Spiel läuft."
