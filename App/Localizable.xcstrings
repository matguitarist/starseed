            "state" : "translated",
            "value" : "Mode"
          }
        }
      }
    },
    "Mods" : {
      "comment" : "Saves tab",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mods"
          }
