            "value" : "No está en Nexus. Abre %@; descarga el archivo y luego suéltalo en esta ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absent de Nexus. Ouvre %@ ; téléchargez le fichier, puis déposez-le sur cette fenêtre."
