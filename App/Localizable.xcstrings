          "stringUnit" : {
            "state" : "translated",
            "value" : "(Während: %@.)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Durante: %@.)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Pendant : %@.)"
          }
        },
        "pt-BR" : {
