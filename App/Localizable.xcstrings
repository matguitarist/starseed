    "The game dropped %lld locations and %lld NPCs from “%@” because their mods aren't installed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel hat %1$lld Orte und %2$lld NPCs aus „%3$@“ verworfen, weil ihre Mods nicht installiert sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The game dropped %1$lld locations and %2$lld NPCs from “%3$@” because their mods aren't installed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego descartó %1$lld lugares y %2$lld NPC de «%3$@» porque sus mods no están instalados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu a ignoré %1$lld lieux et %2$lld PNJ de « %3$@ », car leurs mods ne sont pas installés."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O jogo descartou %1$lld locais e %2$lld NPCs de “%3$@” porque os mods deles não estão instalados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于对应模组未安装，游戏从“%3$@”中丢弃了 %1$lld 个地点和 %2$lld 个 NPC。"
          }
        }
      }
    },
    "The game dropped %lld locations from “%@” because their mods aren't installed." : {
      "localizations" : {
