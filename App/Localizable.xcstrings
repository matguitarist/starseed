        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "菜单栏图标"
          }
        }
      }
    },
    "The Mods folder isn't inside the game, so its version and SMAPI can't be checked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mods-Ordner liegt nicht im Spiel, daher können seine Version und SMAPI nicht geprüft werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta Mods no está dentro del juego, así que no se pueden comprobar su versión ni SMAPI."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier Mods n’est pas dans le jeu : impossible de vérifier sa version et SMAPI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta Mods não está dentro do jogo, então não dá para verificar a versão dele nem o SMAPI."
          }
        },
        "zh-Hans" : {
