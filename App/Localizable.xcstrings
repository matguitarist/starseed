    "Your mods can't be put back while the game is running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Mods können nicht zurückgesetzt werden, während das Spiel läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden restaurar tus mods mientras el juego está abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos mods ne peuvent pas être remis en place pendant que le jeu tourne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível restaurar seus mods com o jogo aberto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏运行时无法恢复你的模组。"
          }
        }
      }
    },
    "Your mods changed, so your saves were backed up before playing (Saves → Backups)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Mods haben sich geändert, daher wurden deine Spielstände vor dem Spielen gesichert (Spielstände → Sicherungen)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus mods cambiaron, así que se copiaron tus partidas antes de jugar (Partidas → Copias)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos mods ont changé : vos sauvegardes ont été copiées avant de jouer (Sauvegardes → Copies)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus mods mudaram, então seus saves receberam backup antes de jogar (Saves → Backups)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的模组有变化，因此在开始游戏前备份了存档（存档 → 备份）"
          }
        }
      }
    },
    "Your personal API key, your account (free or Premium), and **Use This App**, which makes Starseed catch **Mod Manager Download** links clicked in Safari or Chrome." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein persönlicher API-Schlüssel, dein Konto (kostenlos oder Premium) und **Diese App verwenden**, damit Starseed in Safari oder Chrome angeklickte Links **Mod Manager Download** abfängt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave personal de API, tu cuenta (gratuita o Premium) y **Usar esta app**, que hace que Starseed capture los enlaces **Mod Manager Download** en los que hagas clic en Safari o Chrome."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre clé d’API personnelle, votre compte (gratuit ou Premium), et **Utiliser cette app**, qui fait intercepter par Starseed les liens **Mod Manager Download** cliqués dans Safari ou Chrome."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua chave pessoal de API, sua conta (gratuita ou Premium) e **Usar este app**, que faz o Starseed capturar os links **Mod Manager Download** clicados no Safari ou no Chrome."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的个人 API 密钥、你的账户（免费或高级会员），以及**使用此应用**，它让 Starseed 接管你在 Safari 或 Chrome 中点击的 **Mod Manager Download** 链接。"
          }
        }
      }
    },
    "Your progress is kept; the Installed list has a button to come back" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Fortschritt bleibt erhalten; die Installiert-Liste hat eine Schaltfläche zum Zurückkehren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu progreso se conserva; la lista Instalados tiene un botón para volver"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre progression est conservée ; la liste Installés a un bouton pour reprendre"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu progresso fica salvo; a lista Instalados tem um botão para voltar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进度会保留；已安装列表中有返回此处的按钮"
          }
        }
