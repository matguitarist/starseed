    "Kept when a mod is updated, so it can be rolled back (Previous Versions in the details panel). The last 3 of each mod are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei jedem Mod-Update aufbewahrt, damit du zurückwechseln kannst (Frühere Versionen im Detailbereich). Pro Mod werden die letzten 3 behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conservan al actualizar un mod para poder volver atrás (Versiones anteriores en el panel de detalles). Se guardan las 3 últimas de cada mod."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservées à chaque mise à jour d’un mod pour pouvoir revenir en arrière (Versions précédentes dans le panneau de détails). Les 3 dernières de chaque mod sont gardées."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardadas quando um mod é atualizado, para poder voltar (Versões anteriores no painel de detalhes). As 3 últimas de cada mod são mantidas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模组更新时保留，以便回退（详细信息面板中的“以前的版本”）。每个模组保留最近 3 个。"
          }
        }
      }
    },
