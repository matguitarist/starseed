    "Links in Starseed open in its own Nexus browser, which catches **Mod Manager Download** buttons. To catch them in Safari or Chrome too, click **Use This App** in **Settings → Nexus Mods**." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links in Starseed öffnen sich im eigenen Nexus-Browser, der Schaltflächen **Mod Manager Download** abfängt. Damit das auch in Safari oder Chrome klappt, klicke in **Einstellungen → Nexus Mods** auf **Diese App verwenden**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los enlaces de Starseed se abren en su propio navegador de Nexus, que captura los botones **Mod Manager Download**. Para captarlos también en Safari o Chrome, haz clic en **Usar esta app** en **Ajustes → Nexus Mods**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les liens de Starseed s’ouvrent dans son propre navigateur Nexus, qui intercepte les boutons **Mod Manager Download**. Pour les intercepter aussi dans Safari ou Chrome, cliquez sur **Utiliser cette app** dans **Réglages → Nexus Mods**."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os links do Starseed abrem no navegador do Nexus do próprio app, que captura os botões **Mod Manager Download**. Para capturá-los também no Safari ou no Chrome, clique em **Usar este app** em **Ajustes → Nexus Mods**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starseed 中的链接会在其内置的 Nexus 浏览器中打开，它会接管 **Mod Manager Download** 按钮。若想在 Safari 或 Chrome 中也接管，请在**设置 → Nexus Mods**中点击**使用此应用**。"
          }
        }
      }
    },
    "Links in this app open in its own Nexus browser, which catches these downloads itself. Making this app the default also catches “Mod Manager Download” clicks in Safari or Chrome." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links in dieser App öffnen sich in ihrem eigenen Nexus-Browser, der diese Downloads selbst abfängt. Wird die App zum Standard, fängt sie auch Klicks auf „Mod Manager Download“ in Safari oder Chrome ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los enlaces de esta app se abren en su propio navegador de Nexus, que captura estas descargas por sí mismo. Si la haces predeterminada, también captura los clics en «Mod Manager Download» de Safari o Chrome."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les liens de cette app s’ouvrent dans son propre navigateur Nexus, qui intercepte lui-même ces téléchargements. Faire de cette app l’app par défaut intercepte aussi les clics « Mod Manager Download » dans Safari ou Chrome."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os links deste app abrem no navegador do Nexus do próprio app, que captura esses downloads sozinho. Tornar este app o padrão também captura cliques em “Mod Manager Download” no Safari ou no Chrome."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此应用中的链接会在其内置的 Nexus 浏览器中打开，由它自行接管这些下载。将此应用设为默认后，在 Safari 或 Chrome 中点击“Mod Manager Download”也会被接管。"
          }
        }
      }
    },
    "Load More" : {
