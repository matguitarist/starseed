    "It may be broken or outdated. Updating it often helps; if not, report it to its author with your log." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er ist vielleicht defekt oder veraltet. Ein Update hilft oft; sonst melde es dem Autor mit deinem Protokoll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede estar roto o desactualizado. Actualizarlo suele ayudar; si no, avisa a su autor con tu registro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est peut-être défectueux ou obsolète. Le mettre à jour aide souvent ; sinon, signalez le problème à son auteur avec votre journal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele pode estar com defeito ou desatualizado. Atualizar costuma ajudar; se não, avise o autor com o seu registro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它可能已损坏或过时。更新通常能解决；如果不行，请带上日志向作者反馈。"
          }
        }
      }
    },
