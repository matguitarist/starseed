    "Mod update available" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mise à jour de mod disponible"
          }
        }
      }
    },
    "Mod updates and info come from SMAPI's web API and Nexus Mods. Not affiliated with ConcernedApe, SMAPI or Nexus Mods." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
