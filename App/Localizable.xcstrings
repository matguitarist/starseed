    "After a few tests, Starseed names the mod. Keep it off, or put everything back as it was." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach ein paar Tests nennt Starseed den Mod. Lass ihn aus oder stelle alles wieder wie vorher her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras unas pocas pruebas, Starseed nombra el mod. Déjalo desactivado o vuelve a dejarlo todo como estaba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après quelques tests, Starseed nomme le mod. Laissez-le désactivé, ou remettez tout comme avant."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de alguns testes, o Starseed aponta o mod. Deixe-o desativado ou volte tudo como estava."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "几次测试后，Starseed 会指出是哪个模组。你可以保持它关闭，或把一切恢复原样。"
          }
        }
      }
    },
    "After you play" : {
