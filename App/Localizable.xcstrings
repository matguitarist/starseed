    "SMAPI website and log parser" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Site de SMAPI et analyseur de journaux"
          }
        }
      }
    },
    "SMAPI won't load either copy: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI ne chargera aucune des copies : %@"
          }
        }
      }
    },
    "SMAPI writes a log each time the game runs. The **SMAPI Log** section shows the latest one with colors per level (errors, warnings, info…) and filters by level, mod or text." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAPI écrit un journal à chaque lancement du jeu. La section **Journal SMAPI** affiche le plus récent avec une couleur par niveau (erreurs, avertissements, infos…) et des filtres par niveau, mod ou texte."
          }
        }
      }
    },
    "Some Mods Aren't on Nexus" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains mods ne sont pas sur Nexus"
          }
        }
      }
    },
    "Some Mods Couldn't Be Queued" : {
      "localizations" : {
        "fr" : {
