    "Starseed turns off half of your mods. Mods that need each other, and the parts of one mod, stay together." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starseed schaltet die Hälfte deiner Mods aus. Mods, die einander brauchen, und die Teile eines Mods bleiben zusammen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starseed desactiva la mitad de tus mods. Los mods que se necesitan entre sí y las partes de un mismo mod van juntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starseed désactive la moitié de vos mods. Les mods qui ont besoin les uns des autres, et les parties d’un même mod, restent ensemble."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Starseed desativa metade dos seus mods. Mods que dependem uns dos outros e as partes de um mesmo mod ficam juntos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starseed 会关闭一半模组。互相依赖的模组以及同一模组的各个部分会放在一起。"
          }
        }
      }
    },
    "Starseed turns some mods off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starseed schaltet einige Mods aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starseed desactiva algunos mods."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starseed désactive une partie des mods."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Starseed desativa alguns mods."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starseed 会关闭一部分模组。"
          }
        }
      }
    },
    "Starseed updates itself: it checks for new versions once a day and asks before installing. **Starseed → Check for App Updates…** checks right away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starseed aktualisiert sich selbst: Es sucht einmal am Tag nach neuen Versionen und fragt vor dem Installieren. **Starseed → Nach App-Updates suchen …** prüft sofort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starseed se actualiza solo: busca versiones nuevas una vez al día y pregunta antes de instalarlas. **Starseed → Buscar actualizaciones de la app…** lo comprueba al momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starseed se met à jour tout seul : il cherche une nouvelle version une fois par jour et demande avant de l’installer. **Starseed → Rechercher des mises à jour de l’app…** vérifie tout de suite."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Starseed se atualiza sozinho: procura versões novas uma vez por dia e pergunta antes de instalar. **Starseed → Procurar atualizações do app…** verifica na hora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starseed 会自行更新：它每天检查一次新版本，并在安装前询问你。**Starseed → 检查应用更新…**可立即检查。"
          }
        }
      }
    },
    "Starseed's own backups (SMAPI's daily backups aren't touched). Restore them from Saves." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die eigenen Sicherungen von Starseed (die täglichen Sicherungen von SMAPI bleiben unberührt). Stelle sie unter Spielstände wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias propias de Starseed (las copias diarias de SMAPI no se tocan). Restáuralas desde Partidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les copies faites par Starseed (les copies quotidiennes de SMAPI ne sont pas touchées). Restaurez-les depuis Sauvegardes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os backups do próprio Starseed (os backups diários do SMAPI não são tocados). Restaure-os em Saves."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starseed 自己的备份（不会动 SMAPI 的每日备份）。可在“存档”中恢复。"
          }
        }
      }
    },
